{
  "name": "electron-app",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "uuid": "^9.0.1",
    "wait-port": "^1.1.0"
  },
  "scripts": {
    "dev:next": "cd ../my-app && yarn dev",
    "dev:electron": "wait-port 3000 && electron .",
    "dev": "concurrently -k -n next,electron \"yarn dev:next\" \"yarn dev:electron\"",
    "build:next": "cd ../my-app && yarn build",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "yarn build:next && yarn build:win",
    "build:all-platforms": "yarn build:next && electron-builder -mwl",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "drizzle-kit": "^0.31.7",
    "electron": "33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.invoicegenerator.app",
    "productName": "Invoice Generator",
    "directories": {
      "output": "../dist",
      "buildResources": "../build"
    },
    "files": [
      "main.js",
      "preload.js",
      "logger.js",
      "database/**/*",
      "ipc/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "../my-app/.next/standalone/Documents/coding/invoice-generator/my-app",
        "to": "app"
      },
      {
        "from": "../my-app/.next/static",
        "to": "app/.next/static"
      },
      {
        "from": "../my-app/public",
        "to": "app/public"
      },
      {
        "from": "../my-app/.next/standalone/node_modules",
        "to": "app/node_modules"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "../build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "../build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Invoice Generator",
      "runAfterFinish": true,
      "installerIcon": "../build/icon.ico",
      "uninstallerIcon": "../build/icon.ico",
      "license": null,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
