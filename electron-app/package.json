{
  "name": "electron-app",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "electron": "33.0.0",
    "uuid": "^9.0.1",
    "wait-port": "^1.1.0"
  },
  "scripts": {
    "dev:next": "cd ../my-app && yarn dev",
    "dev:electron": "wait-port 3000 && electron .",
    "dev": "concurrently -k -n next,electron \"yarn dev:next\" \"yarn dev:electron\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "drizzle-kit": "^0.31.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.invoicegenerator.app",
    "productName": "Invoice Generator",
    "directories": {
      "output": "../dist",
      "buildResources": "../build"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!**/*.map",
      "!**/.*",
      "!**/*.db-shm",
      "!**/*.db-wal"
    ],
    "extraResources": [
      {
        "from": "../my-app/.next/standalone",
        "to": "app/my-app/.next/standalone",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "../build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "../build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
