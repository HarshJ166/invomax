{
  "name": "invoice-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice Generator Desktop Application",
  "main": "electron-app/main.js",
  "scripts": {
    "dev": "cd electron-app && yarn dev",
    "build": "node scripts/build.js",
    "build:next": "cd my-app && yarn build",
    "dist": "yarn build && cd electron-app && electron-builder --publish=never",
    "dist:mac": "yarn build && cd electron-app && electron-builder --mac",
    "dist:win": "yarn build && cd electron-app && electron-builder --win",
    "dist:linux": "yarn build && cd electron-app && electron-builder --linux",
    "postinstall": "cd electron-app && yarn install && cd ../my-app && yarn install",
    "logs": "node scripts/view-logs.js",
    "logs:monitor": "node scripts/monitor-logs.js"
  }
}

